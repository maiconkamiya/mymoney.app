{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "mymoney",
    "version": "0.3.92",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vp build && node tools/versoes/gerar-versao.mjs",
        "build:ssr": "vp build && node tools/versoes/gerar-versao.mjs && vp build --ssr",
        "dev": "vp dev",
        "check": "vp check",
        "check:fix": "vp check --fix",
        "types:check": "vue-tsc --noEmit",
        "test:versoes": "node --test \"tools/versoes/*.test.mjs\"",
        "test:js": "node --experimental-strip-types --test resources/js/lib/novidadesTexto.test.ts resources/js/lib/fimNegociacao.test.ts",
        "versoes": "node tools/versoes/cli.mjs",
        "release": "node tools/versoes/release.mjs"
    },
    "dependencies": {
        "@fontsource-variable/geist": "^5.3.0",
        "@fontsource-variable/geist-mono": "^5.3.0",
        "@inertiajs/vite": "^3.0.0",
        "@inertiajs/vue3": "^3.0.0",
        "@laravel/echo-vue": "^2.6.1",
        "@laravel/passkeys": "^0.2.0",
        "@lucide/vue": "^1.17.0",
        "@vueuse/core": "^12.8.2",
        "apexcharts": "^8.3.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "laravel-echo": "^2.6.1",
        "laravel-vite-plugin": "^3.0.0",
        "motion-v": "^2.8.0",
        "pusher-js": "^8.6.0",
        "reka-ui": "^2.9.8",
        "simple-icons": "^16.35.0",
        "tailwind-merge": "^3.2.0",
        "tailwindcss": "^4.1.1",
        "tw-animate-css": "^1.2.5",
        "vue": "^3.5.13",
        "vue-input-otp": "^0.3.2",
        "vue-sonner": "^2.0.0"
    },
    "devDependencies": {
        "@laravel/vite-plugin-wayfinder": "^0.1.3",
        "@tailwindcss/vite": "^4.1.11",
        "@types/node": "^22.13.5",
        "@vitejs/plugin-vue": "^6.0.0",
        "concurrently": "^10.0.3",
        "typescript": "^5.2.2",
        "vite": "^8.0.0",
        "vite-plus": "0.3.0",
        "vue-tsc": "^2.2.4"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1",
        "@rollup/rollup-linux-x64-gnu": "4.9.5",
        "@rollup/rollup-win32-x64-msvc": "4.9.5",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.0.1",
        "@tailwindcss/oxide-win32-x64-msvc": "^4.0.1",
        "lightningcss-linux-x64-gnu": "^1.29.1",
        "lightningcss-win32-x64-msvc": "^1.29.1"
    }
}
