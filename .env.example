APP_NAME=MyMoney
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# MyMoney
# "fake" runs without an API key and every agent votes hold; "anthropic" calls Claude.
AGENTS_DRIVER=fake
ANTHROPIC_API_KEY=
AGENTS_FAST_MODEL=claude-haiku-5-5
AGENTS_STRONG_MODEL=claude-opus-5-5

# Embeddings das notícias (deduplicação semântica). "fake" não precisa de chave; "http" usa API no formato OpenAI (ex.: Voyage).
NEWS_EMBEDDINGS_DRIVER=fake
NEWS_EMBEDDINGS_KEY=
NEWS_EMBEDDINGS_MODEL=voyage-3
NEWS_EMBEDDINGS_DIMENSIONS=1024
NEWS_DEDUP_THRESHOLD=0.92
NEWS_VECTOR_STORE=auto

# Candles de cripto (dados públicos). api.binance.com responde 451 em alguns países; este endereço não.
BINANCE_MARKET_DATA_URL=https://data-api.binance.vision

TRADING_CRYPTO_FEE_RATE=0.001
TRADING_CRYPTO_SLIPPAGE_BPS=5
TRADING_B3_FEE_RATE=0.000325
TRADING_B3_EXTRA_HOLIDAYS=
BRAPI_TOKEN=
FATOS_RELEVANTES_RSS_URL=
B3_CANDLE_INTERVAL=1m
B3_CANDLE_RANGE=1d
TRADING_B3_BROKERAGE=0
TRADING_B3_SLIPPAGE_BPS=5

# Serviço Python de previsão (services/forecast). Desligado: o agente quantitativo vota aguardar.
FORECAST_ENABLED=false
FORECAST_URL=http://127.0.0.1:8001
FORECAST_TOKEN=
FORECAST_TIMEOUT=5
FORECAST_HORIZON=15
FORECAST_TRAINING_DAYS=30
FORECAST_PYTHON=python3

# Execução real (fase 5): desligada por padrão. Nunca ligue sem ler a especificação.
TRADING_LIVE_ENABLED=false
TRADING_LIVE_MAX_ORDER_VALUE=20
TRADING_LIVE_MAX_DAILY_VALUE=100
TRADING_SIGNAL_TTL_MINUTES=60
